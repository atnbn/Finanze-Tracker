# Local backend + local Postgres
DB_USER=postgres
DB_HOST=localhost
DB_NAME=fintrack
DB_PASSWORD=postgres
DB_PORT=5432
DB_SSL=false

# Optional: use this instead of DB_USER/DB_HOST/DB_NAME/DB_PASSWORD/DB_PORT
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require

JWT_SECRET=replace-with-a-long-random-secret
APP_NAME=FinTrack

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=FinTrack <your-email@gmail.com>

FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development
